# Drupal/NodeHive Configuration
DRUPAL_BASE_URL=https://netnode.nodehive.app

# NodeHive API Key (RECOMMENDED - Simplest method!)
# Create at: /nodehive/api-keys
NODEHIVE_API_KEY=nhk_your_api_key_here

# OAuth 2.0 Password Grant (User Authentication)
OAUTH_CLIENT_ID=test
OAUTH_CLIENT_SECRET=4321
OAUTH_USERNAME=username
OAUTH_PASSWORD=password

# OAuth 2.0 Client Credentials (Service Account / Server-to-Server)
# Note: Same client ID/secret can often be used for both grants
# OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET are shared above

# JWT Authentication (Legacy)
JWT_EMAIL=user@example.com
JWT_PASSWORD=your-password-here
# JWT_TOKEN=your-existing-jwt-token (optional, for pre-configured token example)

NODE_TLS_REJECT_UNAUTHORIZED=0